# Shortform Studio — macOS Docker Desktop 설정
# ./start.sh 로 Whisper + Docker를 한 번에 시작합니다.
# 이 파일을 .env로 복사해서 사용하세요: cp .env.example .env

# ─── STT (자동 자막) ─────────────────────────────────────────────
# macOS에서 MLX Whisper 사용 (기본, 권장):
STT_PROVIDER=whisper-local
WHISPER_URL=http://host.docker.internal:8787
WHISPER_TIMEOUT_MS=600000

# AssemblyAI 클라우드 사용 시:
# STT_PROVIDER=assemblyai
# ASSEMBLYAI_API_KEY=your-key-here
# ASSEMBLYAI_SPEAKER_LABELS=true

# ─── LLM (숏폼 의미 보강) ────────────────────────────────────────
# 비활성 (기본):
LLM_PROVIDER=disabled

# 로컬 Ollama 사용 시:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=local-only

# 외부 LLM 서버 사용 시:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://your-server:port/v1
# LLM_MODEL=model-name
# LLM_API_KEY=your-api-key
LLM_REQUEST_TIMEOUT_MS=30000

# ─── 렌더링 ──────────────────────────────────────────────────────
SHORTFORM_TMPFS_SIZE=8g
