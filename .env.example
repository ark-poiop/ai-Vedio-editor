# Copy to .env for Docker Compose. Never commit real API keys.
STT_PROVIDER=mock
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEAKER_LABELS=true

# Safe default. Keep disabled when no LLM is needed.
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_MS=30000

# Docker Desktop + host-local OpenAI-compatible LLM example (Ollama/LM Studio/vLLM):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=local-only

# FFmpeg uploads and two concurrent render outputs share /tmp.
SHORTFORM_TMPFS_SIZE=8g